(Plot1 + Plot2) / (Plot3 + Plot4)
library(ape)
Predictors <- Camels_2 |>
select(where(is.numeric)) |>
select(-q_mean, -logQmean, -gauge_lat, -gauge_lon)
Coordinates <- Camels_2 |>
select(gauge_lon, gauge_lat) |>
as.matrix()
Distance_Matrix <- as.matrix(dist(Coordinates))
Weight_1 <- 1 / Distance_Matrix
diag(Weight_1) <- 0
Weight_1[is.infinite(Weight_1)] <- 0
Map_Matrix <- map_dfr(names(Predictors), function(var) {
x <- Camels_2[[var]]
keep <- complete.cases(x, Weight_1)
moran <- ape::Moran.I(x, Weight_1)
tibble(predictor = var, moran_i = moran$observed, expected = moran$expected, p_value = moran$p.value)})
Map_Matrix |>
arrange(desc(moran_i))
Camels_2 <- Camels_2 |>
mutate(Aridity_Camels = ntile(aridity, 4))
Camels_Split_2 <- initial_split(Camels_2, prop = 0.75, strata = Aridity_Camels)
Camels_Train <- training(Camels_Split_2)
Camels_Test  <- testing(Camels_Split_2)
dim(Camels_Train)
dim(Camels_Test)
Prediction <- logQmean ~ aridity + p_mean + pet_mean + frac_snow + elev_mean + slope_mean + area_gages2
+ lai_diff + soil_depth_pelletier + soil_porosity + soil_conductivity +
geol_permeability
Prediction <- logQmean ~ aridity + p_mean + pet_mean + frac_snow +
elev_mean + slope_mean + area_gages2 +
lai_diff + soil_depth_pelletier + soil_porosity +
soil_conductivity + geol_permeability
Recipe_Q4 <- recipe(Prediction, data = Camels_Train) |>
step_impute_median(all_numeric_predictors()) |>
step_log(p_mean, pet_mean, aridity, area_gages2, soil_conductivity, geol_permeability, offset = 1) |>
step_interact(terms = ~ p_mean:aridity + p_mean:pet_mean) |>
step_normalize(all_numeric_predictors()) |>
step_zv(all_predictors())
Random_Forest <- rand_forest() |>
set_engine("ranger", importance = "impurity") |>
set_mode("regression")
XGB_Model <- boost_tree() |>
set_engine("xgboost") |>
set_mode("regression")
LM_Model <- linear_reg() |>
set_engine("lm") |>
set_mode("regression")
library(spatialsample)
library(sf)
set.seed(123)
CV <- vfold_cv(Camels_Train, v = 10)
Camels_Train_2 <- Camels_Train |>
st_as_sf(coords = c("gauge_lon", "gauge_lat"), crs = 4326)
set.seed(123)
CV_2 <- spatial_block_cv(Camels_Train_2,v = 10)
Workflow_2 <- workflow_set(
preproc = list(rec = Recipe_Q4),
models = list(rf = Random_Forest, xgb = XGB_Model, lm = LM_Model))
Workflow_Random <- Workflow_2 |>
workflow_map("fit_resamples", resamples = CV)
Workflow_Map <- Workflow_2 |>
workflow_map("fit_resamples", resamples = CV_2)
autoplot(Workflow_Random)
rank_results(Workflow_Random, rank_metric = "rsq", select_best = TRUE)
autoplot(Workflow_Map)
rank_results(Workflow_Map, rank_metric = "rsq", select_best = TRUE)
Tuned <- rand_forest(mtry = tune(), min_n = tune(), trees = 500) |>
set_engine("ranger", importance = "impurity") |>
set_mode("regression")
NGrid <- grid_regular(mtry(range = c(2, 12)), min_n(range = c(2, 20)), levels = 5)
Tuned_Workflow <- workflow() |>
add_recipe(Recipe_Q4) |>
add_model(Tuned)
set.seed(123)
Tuned_Grid <- tune_grid(Tuned_Workflow, resamples = CV_2, grid = NGrid,
control = control_grid(save_pred = TRUE))
autoplot(Tuned_Grid)
show_best(Tuned_Grid, metric = "rsq")
Tuned_Best <- select_best(Tuned_Grid, metric = "rsq")
Tuned_Best
Workflow_Final <- finalize_workflow(Tuned_Workflow, Tuned_Best)
Workflow_Fit <- fit(Workflow_Final, data = Camels_Train)
Workflow_Fit |>
extract_fit_parsnip() |>
vip::vip()
Workflow_Final
Fit_Final <- last_fit(Workflow_Final, split = Camels_Split_2)
collect_metrics(Fit_Final)
Prediction_Final <- collect_predictions(Fit_Final)
Test_Info <- assessment(Camels_Split_2) |>
select(aridity)
Prediction_Final <- bind_cols(Prediction_Final, Test_Info)
ggplot(Prediction_Final, aes(x = logQmean, y = .pred, color = aridity)) +
geom_point() +
geom_abline() +
scale_color_viridis_c() +
theme_linedraw() +
labs(title = "Observed vs Predicted Log Mean Streamflow", x = "Observed Flow", y = "Predicted Flow",
color = "Aridity")
ggplot(Prediction_Final, aes(x = logQmean, y = .pred, color = aridity)) +
geom_point() +
geom_abline() +
scale_color_viridis_c() +
theme_linedraw() +
labs(title = "Observed vs Predicted Log Mean Streamflow", x = "Log Observed Flow", y = "Log Predicted Flow",
color = "Aridity")
