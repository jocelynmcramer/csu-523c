NDWI_Classify  <- app(NDWI, fun = function(x) ifelse(x > 0, 1, 0))
MNDWI_Classify <- app(MNDWI, fun = function(x) ifelse(x > 0, 1, 0))
WRI_Classify   <- app(WRI, fun = function(x) ifelse(x > 1, 1, 0))
SWI_Classify   <- app(SWI, fun = function(x) ifelse(x < 5, 1, 0))
