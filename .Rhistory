Camels_2 <- camels |>
mutate(logQmean = log(q_mean)) |>
filter(is.finite(logQmean)) |>
select(gauge_id, gauge_lat, gauge_lon, q_mean, logQmean, aridity, p_mean, pet_mean, frac_snow,
elev_mean, slope_mean, area_gages2, lai_max, lai_diff, soil_depth_pelletier,
soil_porosity, soil_conductivity, geol_permeability)
skimr::skim(Camels_2)
visdat::vis_dat(Camels_2)
Plot1 <- ggplot(Camels_2, aes(x = q_mean)) +
geom_histogram(bins = 30) +
labs(title = "Mean Streamflow", x = "Q_Mean", y = "Count") +
theme_linedraw()
Plot2 <- ggplot(Camels_2, aes(x = logQmean)) +
geom_histogram(bins = 30) +
labs(title = "Log Mean Streamflow", x = "Log(Q_Mean)", y = "Count") +
theme_linedraw()
