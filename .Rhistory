title("My Choice (SWIR1-R-G)")
NDVI  <- (Palo_Crop[["nir08"]] - Palo_Crop[["red"]]) / (Palo_Crop[["nir08"]] + Palo_Crop[["red"]])
NDWI  <- (Palo_Crop[["green"]] - Palo_Crop[["nir08"]]) / (Palo_Crop[["green"]] + Palo_Crop[["nir08"]])
MNDWI <- (Palo_Crop[["green"]] - Palo_Crop[["swir16"]]) / (Palo_Crop[["green"]] + Palo_Crop[["swir16"]])
WRI   <- (Palo_Crop[["green"]] + Palo_Crop[["red"]]) / (Palo_Crop[["nir08"]] + Palo_Crop[["swir16"]])
SWI   <- 1 / sqrt(Palo_Crop[["blue"]] - Palo_Crop[["swir16"]])
Stacked <- c(NDVI, NDWI, MNDWI, WRI, SWI)
Stacked <- setNames(Stacked, c("NDVI", "NDWI", "MNDWI", "WRI", "SWI"))
plot(Stacked, col = colorRampPalette(c("blue", "white", "red"))(256))
NDVI_Flood <- app(NDVI, fun = function(x) ifelse(x < 0, 1, 0))
NDWI_Flood <- app(NDWI, fun = function(x) ifelse(x > 0, 1, 0))
MNDWI_Flood <- app(MNDWI, fun = function(x) ifelse(x > 0, 1, 0))
WRI_Flood  <- app(WRI, fun = function(x) ifelse(x > 1, 1, 0))
SWI_Flood  <- app(SWI, fun = function(x) ifelse(x < 5, 1, 0))
Stacked_Flood <- c(NDVI_Flood, NDWI_Flood, MNDWI_Flood, WRI_Flood, SWI_Flood)
Stacked_Flood <- setNames(Stacked_Flood, c("NDVI", "NDWI", "MNDWI", "WRI", "SWI"))
plot(Stacked_Flood, col = c("white", "blue"))
