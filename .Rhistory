Palo_Crop <- crop(r, vect(AOI_proj))
Palo_AOI <- st_transform(AOI, crs(r))
Palo_Crop <- crop(r, vect(Palo_AOI))
par(mfrow = c(2, 2))
plotRGB(Palo_Crop, r = which(names(Palo_Crop) == "red"), g = which(names(Palo_Crop) == "green"),
b = which(names(Palo_Crop) == "blue"), stretch = "lin")
title("Natural Color (R-G-B)")
