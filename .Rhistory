files <- list.files(
"lab-04_files",
pattern = "\\.tif$|\\.TIF$",
full.names = TRUE,
recursive = TRUE
)
# Make sure files are in band order
files <- files[match(
c("SR_B1", "SR_B2", "SR_B3", "SR_B4", "SR_B5", "SR_B6"),
sub(".*_(SR_B[1-6])\\.TIF$", "\\1", basename(files))
)]
# Create raster stack
