# Name the layers
names(r) <- bands
# Check result
r
# Open a connection to the MPC STAC API
(stac_query <- stac("https://planetarycomputer.microsoft.com/api/stac/v1"))
files <- files[grepl("LC08", basename(files))]
files <- files[1:6]
files <- sort(files)
r <- rast(files)
r <- setNames(r, bands)
dim(r)
crs(r)
res(r)
AOI <- st_as_sfc(st_bbox(c(xmin = -91.83, xmax = -91.73, ymin = 42.03, ymax = 42.09), crs = 4326))
